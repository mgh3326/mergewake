<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.mergewake</string>
  <key>ProgramArguments</key><array>
    <string>/path/to/mergewake</string><string>daemon</string>
    <string>--config</string><string>/path/to/config.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>ExitTimeOut</key><integer>900</integer>
  <key>StandardOutPath</key><string>/path/to/mergewake.stdout.log</string>
  <key>StandardErrorPath</key><string>/path/to/mergewake.stderr.log</string>
</dict></plist>
